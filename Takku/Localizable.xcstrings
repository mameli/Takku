    },
    "< %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "< %@"
          }
        }
      }
    },
    "Add credit…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi credito…"
          }
        }
      }
    },
    "Add Takku Credit": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi Takku Credit"
          }
        }
      }
    },
    "Added to every request as written; each key replaces what Takku sends for it. For what a model needs beyond the Reasoning menu: see the provider's documentation.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti a ogni richiesta così come sono; ogni chiave sostituisce quella che manda Takku. Per quello che serve a un modello oltre al menu Ragionamento, vedi la documentazione del provider."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API"
          }
        }
      }
    },
    "About 20 MB per hour of Meeting. Notes and Transcripts stay in the Vault: without the audio, Retry makes only the Summary again. The Summary log keeps what was sent to the model and its replies, in ~/.takku/summary-log, to improve the Templates: up to 5 MB, the oldest go first.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 20 MB per ora di riunione. Note e trascrizioni restano nel Vault: senza l'audio, Riprova rifà solo il riepilogo. Il log dei Riepiloghi tiene ciò che è stato mandato al modello e le sue risposte, in ~/.takku/summary-log, per migliorare i Template: fino a 5 MB, i più vecchi se ne vanno per primi."
          }
        }
      }
    },
    "Add Profile": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi Profilo"
          }
        }
      }
    },
    "Allow Takku in System Settings → Login Items.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Takku in Impostazioni di Sistema → Elementi login."
          }
        }
      }
    },
    "Any server with an OpenAI-compatible API. For work meetings use only local Providers or Providers based and hosting data in the EU.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi server con API compatibile OpenAI. Per le riunioni di lavoro usa solo Provider locali o con sede e dati in UE."
          }
        }
      }
    },
