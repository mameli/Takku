    "Import audio: a voice memo, a lecture, a meeting in person or a video becomes a note like the others.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa audio: un memo vocale, una lezione, un meeting di persona o un video diventano una nota come le altre."
          }
        }
      }
    },
