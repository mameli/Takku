{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a valid file name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" non è un nome di file valido."
          }
        }
      }
    },
    "%@ The note will be created at the end of Processing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La nota verrà creata a fine Elaborazione."
          }
        }
      }
    },
    "%@ Track: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia %1$@: %2$@"
          }
        }
      }
    },
    "%@ keeps changing while Takku tries to update it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua a cambiare mentre Takku prova ad aggiornarla."
          }
        }
      }
    },
    "A new Template starts from Notes: change instructions and sections with Edit With. They live in ~/.takku/templates/.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Template nuovo parte da Notes: istruzioni e sezioni le cambi con Modifica con. Sono in ~/.takku/templates/."
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiave API"
          }
        }
      }
    },
    "About 20 MB per hour of Meeting. Notes and Transcripts stay in the Vault: without the audio, Retry makes only the Summary again.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa 20 MB per ora di riunione. Note e trascrizioni restano nel Vault: senza l'audio, Riprova rifà solo il riepilogo."
          }
        }
      }
    },
    "Add Profile": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi Profilo"
          }
        }
      }
    },
    "Allow Takku in System Settings → Login Items.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti Takku in Impostazioni di Sistema → Elementi login."
          }
        }
      }
    },
    "Any server with an OpenAI-compatible API. For work meetings use only local Providers or Providers based and hosting data in the EU.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi server con API compatibile OpenAI. Per le riunioni di lavoro usa solo Provider locali o con sede e dati in UE."
          }
        }
      }
    },
    "Audio on this Mac": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio su questo Mac"
          }
        }
      }
    },
    "Base URL": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "URL base"
          }
        }
      }
    },
    "Cannot read the audio of %@.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l'audio di %@."
          }
        }
      }
    },
    "Changes are saved as you type. The key goes to the Keychain when you press Return or Save key.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si salvano mentre scrivi. La chiave va nel Portachiavi quando premi Invio o Salva chiave."
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli…"
          }
        }
