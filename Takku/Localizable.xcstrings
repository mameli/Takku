    "One Markdown note per meeting, which any app opens. Obsidian too, if you use it: choose your vault.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota Markdown per riunione, che si apre con qualsiasi app. Anche con Obsidian, se lo usi: scegli il tuo vault."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Markdown-Notiz pro Besprechung, die jede App öffnen kann. Auch Obsidian, falls du es nutzt: Wähle deinen Vault."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una nota Markdown por reunión que puedes abrir con cualquier app. También con Obsidian, si lo usas: elige tu bóveda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une note Markdown par réunion, lisible par n’importe quelle application. Obsidian aussi, si vous l’utilisez : choisissez votre coffre."
          }
        }
      }
    },
    "Takku records your voice and the call. macOS asks once for each: choose Allow.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku registra la tua voce e la chiamata. macOS chiede una volta per ciascuna: scegli Consenti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku nimmt deine Stimme und den Anruf auf. macOS fragt für beides einmalig nach: Wähle „Erlauben“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku graba tu voz y la llamada. macOS pide permiso una vez para cada una: elige Permitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku enregistre votre voix et l’appel. macOS demande l’autorisation une fois pour chacun : choisissez Autoriser."
          }
        }
      }
    },
