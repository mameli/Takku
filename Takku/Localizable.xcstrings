{
  "sourceLanguage" : "en",
  "strings" : {
    "\"%@\" is not a valid file name." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" non è un nome di file valido."
          }
        }
      }
    },
    "%@ (default)" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (predefinito)"
          }
        }
      }
    },
    "%@ and %lld more" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ e altri %lld"
          }
        }
      }
    },
    "%@ contains no audio." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ non contiene audio."
          }
        }
      }
    },
    "%@ keeps changing while Takku tries to update it." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ continua a cambiare mentre Takku prova ad aggiornarla."
