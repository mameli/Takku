          }
        }
      }
    },
    "They work from any app. Change one if another app already uses its keys.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funzionano da qualsiasi app. Cambiane una se un'altra app usa già gli stessi tasti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie funktionieren aus jeder App heraus. Ändere ein Kurzbefehl, falls eine andere App dieselben Tasten nutzt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funcionan desde cualquier aplicación. Cambia uno si otra app ya usa esas teclas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils fonctionnent depuis n’importe quelle application. Modifiez-en un si une autre application utilise déjà ces touches."
          }
        }
      }
    },
    "Tick every language your meetings are in.": {
      "localizations": {
        "it": {
