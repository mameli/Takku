    "%@'s own default, not the model chosen in your %@ settings: Takku does not read them.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il predefinito di %1$@, non il modello scelto nelle tue impostazioni di %2$@: Takku non le legge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eigene Standard von %1$@, nicht das in deinen %2$@-Einstellungen gewählte Modell: Takku liest sie nicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El predeterminado de %1$@, no el modelo elegido en tus ajustes de %2$@: Takku no los lee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle par défaut de %1$@, pas celui choisi dans vos réglages %2$@ : Takku ne les lit pas."
          }
        }
      }
    },
    "Changes are saved as you type.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche si salvano mentre scrivi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen werden beim Tippen gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios se guardan mientras escribes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications sont enregistrées pendant la saisie."
          }
        }
      }
    },
    "Where the text goes is your choice: for work meetings, use local Providers or Providers that keep data in the EU.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove va il testo lo scegli tu: per le riunioni di lavoro usa Provider locali o Provider che tengono i dati nell'UE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wohin der Text geht, entscheidest du: Für Arbeitsbesprechungen nutze lokale Anbieter oder Anbieter, die Daten in der EU speichern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adónde va el texto lo eliges tú: para reuniones de trabajo, usa proveedores locales o proveedores que guarden los datos en la UE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est vous qui choisissez où va le texte : pour les réunions de travail, utilisez des fournisseurs locaux ou des fournisseurs qui gardent les données dans l’UE."
          }
        }
      }
    },
    "%@ is not installed: install it with %@ in Terminal, then sign in with %@.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non è installato: installalo con %2$@ nel Terminale, poi accedi con %3$@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nicht installiert: Installiere es mit %2$@ im Terminal und melde dich dann mit %3$@ an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
