          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jours"
          }
        }
      }
    },
    "*Name speakers…* plays a few seconds of each voice, so you know who is who.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "*Assegna nomi agli Speaker…* fa sentire qualche secondo di ogni voce, così sai chi è chi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "*Sprecher benennen…* spielt einige Sekunden jeder Stimme ab, damit du weißt, wer wer ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "*Asignar nombres a los hablantes…* reproduce unos segundos de cada voz para que sepas quién es quién."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "*Nommer les intervenants…* fait écouter quelques secondes de chaque voix pour savoir qui est qui."
          }
        }
      }
    },
