            "value": "Pista %1$@: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piste %1$@ : %2$@"
          }
        }
      }
    },
    "%@ keeps changing while Takku tries to update it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua a cambiare mentre Takku prova ad aggiornarla."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ändert sich ständig, während Takku versucht, die Datei zu aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue cambiando mientras Takku intenta actualizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continue d’être modifié pendant que Takku essaie de le mettre à jour."
          }
        }
      }
    },
    "%lld days": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giorni"
          }
        },
        "de": {
