    "Added to every request as written; each key replaces what Takku sends for it. For what a model needs beyond the Reasoning menu: see the provider's documentation.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti a ogni richiesta così come sono; ogni chiave sostituisce quella che manda Takku. Per quello che serve a un modello oltre al menu Ragionamento, vedi la documentazione del provider."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird unverändert zu jeder Anfrage hinzugefügt; jeder Schlüssel ersetzt den von Takku gesendeten Wert. Weitere Modellparameter findest du in der Dokumentation des Anbieters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añaden tal cual a cada solicitud; cada clave reemplaza la que envía Takku. Para lo que necesite un modelo más allá del menú Razonamiento, consulta la documentación del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés tels quels à chaque requête ; chaque clé remplace celle envoyée par Takku. Pour les options au-delà du menu Raisonnement, consultez la documentation du fournisseur."
          }
        }
      }
    },
    "Available once the current meeting finishes processing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile quando la riunione in corso finisce di essere elaborata."
