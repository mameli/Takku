    "%@ Track: %@" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traccia %1$@: %2$@"
          }
        }
      }
    },
    "%@, %lld MB, downloaded once and prepared for this Mac. It takes a few minutes: you can go on meanwhile." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@, %2$lld MB, scaricato una volta e preparato per questo Mac. Ci vogliono alcuni minuti: intanto puoi andare avanti."
          }
        }
      }
    },
    "%@: see ~/.takku/hooks/after-processing.log" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: vedi ~/.takku/hooks/after-processing.log"
