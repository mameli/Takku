    "⚠️ No sound from the microphone for %lld min" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Nessun suono dal microfono da %lld min"
          }
        }
      }
    },
    "⚠️ No sound from the system audio for %lld min" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "⚠️ Nessun suono dall'audio di sistema da %lld min"
