    "%@ The note will be created at the end of Processing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La nota verrà creata a fine Elaborazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die Notiz wird am Ende der Verarbeitung erstellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La nota se creará al finalizar el procesamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La note sera créée à la fin du traitement."
          }
        }
      }
    },
    "%@ Track: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia %1$@: %2$@"
