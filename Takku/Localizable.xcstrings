          "stringUnit": {
            "state": "translated",
            "value": "Cambia…"
          }
        }
      }
    },
    "Choose the recording of a meeting, a lecture or a voice memo, audio or video.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la registrazione di una riunione, di una lezione o un memo vocale, audio o video."
