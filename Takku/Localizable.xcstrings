    "Takku has recorded nothing from your microphone for 2 minutes. Check System Settings → Privacy & Security → Microphone.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 2 minuti Takku non registra niente dal tuo microfono. Controlla Impostazioni di Sistema → Privacy e sicurezza → Microfono."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku hat seit 2 Minuten nichts von deinem Mikrofon aufgenommen. Prüfe Systemeinstellungen → Datenschutz & Sicherheit → Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku no ha grabado nada de tu micrófono durante 2 minutos. Comprueba Ajustes del Sistema → Privacidad y seguridad → Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku n’a rien enregistré depuis votre microphone pendant 2 minutes. Vérifiez Réglages Système → Confidentialité et sécurité → Microphone."
          }
        }
      }
    },
    "Takku has recorded nothing from the call for 2 minutes. Check System Settings → Privacy & Security → Screen & System Audio Recording.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da 2 minuti Takku non registra niente dalla chiamata. Controlla Impostazioni di Sistema → Privacy e sicurezza → Registrazione schermo e audio di sistema."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku hat seit 2 Minuten nichts vom Anruf aufgenommen. Prüfe Systemeinstellungen → Datenschutz & Sicherheit → Bildschirm- & Systemtonaufnahme."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku no ha grabado nada de la llamada durante 2 minutos. Comprueba Ajustes del Sistema → Privacidad y seguridad → Grabación de pantalla y audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku n’a rien enregistré de l’appel pendant 2 minutes. Vérifiez Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et de l’audio système."
          }
        }
      }
    },
