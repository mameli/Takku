            "state": "translated",
            "value": "Este Mac no es compatible con Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac ne prend pas en charge Apple Intelligence."
          }
        }
      }
    },
    "Apple Intelligence is turned off: turn it on in System Settings → Apple Intelligence & Siri.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence è disattivato: attivalo in Impostazioni di Sistema → Apple Intelligence e Siri."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ist deaktiviert: Aktiviere es in Systemeinstellungen → Apple Intelligence & Siri."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence está desactivado: actívalo en Ajustes del Sistema → Apple Intelligence y Siri."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est désactivé : activez-le dans Réglages Système → Apple Intelligence et Siri."
          }
        }
      }
    },
    "Apple Intelligence is still getting its model ready: try again in a few minutes.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sta ancora preparando il suo modello: riprova tra qualche minuto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bereitet sein Modell noch vor: Versuche es in ein paar Minuten erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún está preparando su modelo: vuelve a intentarlo en unos minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence prépare encore son modèle : réessayez dans quelques minutes."
          }
        }
      }
    },
    "Apple Intelligence is not available on this Mac right now.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence non è disponibile su questo Mac in questo momento."
          }
        },
        "de": {
