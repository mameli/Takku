    "A model hosted in the EU, and nothing is kept. No subscription, no account, and the credit never expires.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello ospitato in UE, e niente viene conservato. Niente abbonamento, niente account, e il credito non scade."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein in der EU gehostetes Modell, bei dem nichts gespeichert wird. Kein Abo, kein Konto und das Guthaben verfällt nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modelo alojado en la UE donde no se guarda nada. Sin suscripción, sin cuenta y el saldo nunca caduca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle hébergé dans l’UE et rien n’est conservé. Sans abonnement, sans compte, et le crédit n’expire jamais."
          }
        }
      }
    },
