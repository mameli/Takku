    "Once a day Takku asks GitHub for the latest version; nothing about you or your meetings is sent.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta al giorno Takku chiede a GitHub l'ultima versione; non invia niente su di te o sulle tue riunioni."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku fragt einmal täglich bei GitHub nach der neuesten Version; es werden keinerlei Daten über dich oder deine Besprechungen gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez al día Takku consulta en GitHub la última versión; no se envía nada sobre ti ni sobre tus reuniones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par jour, Takku vérifie la dernière version sur GitHub ; aucune donnée vous concernant ou concernant vos réunions n’est envoyée."
          }
        }
      }
    },
