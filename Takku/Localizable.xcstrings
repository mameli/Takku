    "Your Takku Credit is used up. Add credit in Settings → Summary Profiles, then Retry the Meeting.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il credito Takku Credit è finito. Aggiungi credito in Impostazioni → Profili per il Riepilogo, poi usa Riprova sulla riunione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Takku-Credit-Guthaben ist aufgebraucht. Lade unter Einstellungen → Zusammenfassungsprofile Guthaben auf und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu saldo de Takku Credit se ha agotado. Añade saldo en Ajustes → Perfiles de resumen y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre crédit Takku Credit est épuisé. Ajoutez du crédit dans Réglages → Profils de résumé, puis réessayez."
          }
        }
      }
    },
    "“Let’s start from the numbers of the quarter…”": {
