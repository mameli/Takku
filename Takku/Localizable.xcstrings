            "value": "Transcript non trovato."
          }
        }
      }
    },
    "Meeting state not saved to disk: a restart now would not resume it. %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stato della Riunione non salvato su disco: un riavvio ora non la riprenderebbe. %@"
          }
