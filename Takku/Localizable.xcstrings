    "The languages of your meetings, and the model that transcribes them on this Mac.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lingue dei tuoi meeting, e il modello che li trascrive su questo Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprachen deiner Besprechungen und das Modell, das sie auf diesem Mac transkribiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
