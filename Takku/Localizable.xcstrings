    "Is the meeting still going on? If not, stop it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riunione è ancora in corso? Se no, fermala."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Läuft die Besprechung noch? Wenn nicht, beende sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sigue la reunión? Si no, detenla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La réunion est-elle toujours en cours ? Sinon, arrêtez-la."
          }
        }
      }
    },
    "Meeting stopped": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riunione fermata"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Besprechung beendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reunión detenida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réunion arrêtée"
          }
        }
      }
    },
    "Nobody has spoken for 15 minutes, so Takku stopped recording and is writing the note.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno parla da 15 minuti: Takku ha fermato la registrazione e sta scrivendo la nota."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seit 15 Minuten hat niemand gesprochen: Takku hat die Aufnahme beendet und schreibt die Notiz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie ha hablado en 15 minutos: Takku ha detenido la grabación y está escribiendo la nota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne n’a parlé depuis 15 minutes : Takku a arrêté l’enregistrement et rédige la note."
          }
        }
      }
    },
    "Show": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anzeigen"
