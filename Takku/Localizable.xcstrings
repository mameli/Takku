        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es transkribiert beides auf diesem Mac: Das Audio verlässt ihn nie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los transcribe en este Mac: el audio nunca sale de aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il les transcrit sur ce Mac : l’audio n’en sort jamais."
