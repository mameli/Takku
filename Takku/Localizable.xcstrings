    "Ollama or LM Studio, with a model on your Mac. Nothing leaves this Mac; quality and speed depend on the model your Mac can run.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama o LM Studio, con un modello sul tuo Mac. Niente esce da questo Mac; qualità e velocità dipendono dal modello che il tuo Mac riesce a far girare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama oder LM Studio mit einem Modell auf deinem Mac. Nichts verlässt diesen Mac; Qualität und Geschwindigkeit hängen vom gewählten Modell ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama o LM Studio, con un modelo en tu Mac. Nada sale de este Mac; la calidad y la velocidad dependen del modelo que tu Mac pueda ejecutar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama ou LM Studio, avec un modèle sur votre Mac. Rien ne sort de ce Mac ; la qualité et la vitesse dépendent du modèle que votre Mac peut faire tourner."
          }
        }
      }
    },
