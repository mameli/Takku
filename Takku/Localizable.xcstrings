    "Model": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello"
          }
        }
      }
    },
    "Models run on this Mac. Each is downloaded once from Hugging Face: only the model is downloaded, no audio or text is sent. The model in use applies to new Meetings and to Retry.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli girano su questo Mac. Ognuno si scarica una volta sola da Hugging Face: viene scaricato solo il modello, nessun audio o testo viene inviato. Il modello in uso vale per le nuove riunioni e per Riprova."
          }
        }
      }
    },
    "Move the Template \"%@\" to the Trash?": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare il Template \"%@\" nel Cestino?"
          }
        }
      }
    },
    "Move to Trash": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
