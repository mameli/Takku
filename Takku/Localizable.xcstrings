    },
    "Extra parameters: \"%@\" is set by Takku and cannot be replaced.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parametri extra: \"%@\" lo imposta Takku e non si può sostituire."
          }
        }
      }
    },
    "Extra parameters: this is not valid JSON.": {
      "extractionState": "manual",
