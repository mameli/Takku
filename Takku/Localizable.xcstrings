    "Invalid Profile URL: \"%@\" (http:// or https:// and an address are needed).": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "URL del Profilo non valido: \"%@\" (servono http:// o https:// e un indirizzo)."
          }
        }
      }
    },
    "It cannot be undone. Meetings being recorded or processed are not touched.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. Le riunioni in registrazione o in elaborazione non vengono toccate."
          }
        }
      }
    },
    "It works. Reply: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona. Risposta: %@"
          }
        }
