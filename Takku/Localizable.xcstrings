{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a valid file name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" non è un nome di file valido."
          }
        }
      }
    },
    "%@ contains no audio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non contiene audio."
          }
        }
      }
    },
    "%@ pack": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetto da %@"
          }
        }
      }
    },
    "%@ pack · Recommended": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetto da %@ · Consigliato"
          }
        }
      }
    },
    "%@ The note will be created at the end of Processing.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ La nota verrà creata a fine Elaborazione."
          }
        }
      }
    },
    "%@ Track: %@": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Traccia %1$@: %2$@"
          }
        }
      }
    },
    "%@ keeps changing while Takku tries to update it.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ continua a cambiare mentre Takku prova ad aggiornarla."
          }
        }
      }
    },
    "%lld days": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giorni"
          }
        }
      }
    },
    "1 day": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "1 giorno"
          }
        }
