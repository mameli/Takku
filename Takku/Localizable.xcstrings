{
  "sourceLanguage": "en",
  "strings": {
    "\"%@\" is not a valid file name.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" non è un nome di file valido."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ist kein gültiger Dateiname."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es un nombre de archivo válido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas un nom de fichier valide."
          }
        }
      }
    },
    "%@ contains no audio.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non contiene audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ enthält kein Audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no contiene audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne contient aucun audio."
          }
        }
      }
    },
    "%@ keeps the window you are looking at, under its point in the Summary.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tiene la finestra che stai guardando, sotto il suo punto nel Riepilogo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speichert das betrachtete Fenster direkt unter dem passenden Punkt der Zusammenfassung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ guarda la ventana que estás mirando debajo de su punto correspondiente en el resumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ capture la fenêtre affichée et la place sous le point correspondant du résumé."
          }
        }
      }
    },
    "%@ marks a moment: it gets a star, and the Summary gives it priority.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ segna un momento: prende una stella e il Riepilogo gli dà priorità."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ markiert einen Moment: Er erhält einen Stern und wird in der Zusammenfassung priorisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ marca un momento: recibe una estrella y el resumen le da prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ marque un moment : il reçoit une étoile et le résumé lui donne la priorité."
          }
        }
      }
    },
    "%@ pack": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetto da %@"
