          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher"
          }
        }
      }
    },
    "Some of the meeting is in %@, not among the meeting languages: it is transcribed anyway. Tick %@ in Settings → Transcription.": {
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte della riunione è in %1$@, che non è tra le lingue delle riunioni: è trascritta comunque. Spunta %2$@ in Impostazioni → Trascrizione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil der Besprechung ist auf %1$@, das nicht zu den Besprechungssprachen gehört: Er wird trotzdem transkribiert. Wähle %2$@ in Einstellungen → Transkription."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de la reunión está en %1$@, que no está entre los idiomas de las reuniones: se transcribe igualmente. Marca %2$@ en Ajustes → Transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie de la réunion est en %1$@, qui ne fait pas partie des langues des réunions : elle est transcrite quand même. Cochez %2$@ dans Réglages → Transcription."
          }
        }
      }
    },
    "Something not working?": {
      "localizations": {
