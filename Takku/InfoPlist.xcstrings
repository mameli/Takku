{
  "sourceLanguage": "en",
  "strings": {
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku nimmt den Systemton der anderen Besprechungsteilnehmer auf, um ihn zu transkribieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku graba el audio de los demás participantes en las reuniones para transcribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku enregistre l’audio des autres participants aux réunions afin de le transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku registra l'audio degli altri partecipanti alle riunioni per trascriverlo."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku benennt die Besprechungsnotiz nach dem laufenden Kalendereintrag und führt die eingeladenen Teilnehmer auf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku da a la nota de la reunión el nombre del evento en curso y enumera a las personas invitadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku nomme la note de réunion d’après l’événement en cours et liste les personnes invitées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku dà alla nota della riunione il nome dell'evento in corso ed elenca chi è stato invitato."
          }
        }
      }
    },
    "NSDesktopFolderUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku liest die Audio- oder Videodateien, die du mit dem Befehl takku importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku lee los archivos de audio o vídeo que importas con el comando takku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku lit les fichiers audio ou vidéo que vous importez avec la commande takku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku legge i file audio o video che importi con il comando takku."
          }
        }
      }
    },
    "NSDocumentsFolderUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku schreibt deine Notizen in den gewählten Ordner und liest die Dateien, die du mit dem Befehl takku importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku escribe tus notas en la carpeta que elegiste y lee los archivos que importas con el comando takku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku écrit vos notes dans le dossier choisi et lit les fichiers que vous importez avec la commande takku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku scrive le note nella cartella che hai scelto e legge i file che importi con il comando takku."
          }
        }
      }
    },
    "NSDownloadsFolderUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku liest die Audio- oder Videodateien, die du mit dem Befehl takku importierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku lee los archivos de audio o vídeo que importas con el comando takku."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku lit les fichiers audio ou vidéo que vous importez avec la commande takku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku legge i file audio o video che importi con il comando takku."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku nimmt deine Stimme während Besprechungen auf, um sie zu transkribieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku graba tu voz durante las reuniones para transcribirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku enregistre votre voix pendant les réunions afin de la transcrire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Takku registra la tua voce durante le riunioni per trascriverla."
          }
        }
      }
    }
  },
  "version": "1.0"
}
